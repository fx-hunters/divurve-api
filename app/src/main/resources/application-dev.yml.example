# ── 로컬 개발 프로파일 템플릿 ──────────────────────────────────────────────
# 이 파일을 application-dev.yml 로 복사한 뒤 값을 채운다. 복사본은 .gitignore 에 있어 커밋되지 않는다.
#
#   cp app/src/main/resources/application-dev.yml.example \
#      app/src/main/resources/application-dev.yml
#
# dev 는 기본 활성 프로파일이므로, 복사본이 없으면 datasource 설정이 비어 기동에 실패한다.

app:
  frontend-url: http://localhost:5173

  # 외부 API 키. 비워 두면 ECOS 를 쓰는 모든 경로가 실패한다
  # (/xray · /forecast · /market/regime · /stress — Mock 구현체가 없어 실제 호출만 존재한다).
  # 키가 채워져 있으면 meta.data_state 가 live 로, sources 가 ["ECOS"] 로 나간다.
  # 발급: ECOS https://ecos.bok.or.kr/api  ·  FRED https://fredaccount.stlouisfed.org/apikeys
  # 운영(prod)은 이 파일을 쓰지 않고 ECOS_API_KEY / FRED_API_KEY 환경변수로만 주입한다.
  external:
    ecos:
      api-key: ""
    fred:
      api-key: ""
    # AI 설명을 실 Claude API 로 받으려면 api-key 를 채우고 enabled 를 켠다 (이슈 #73).
    # 비워 두면 MockAiProvider 의 템플릿 문장이 그대로 나간다 — 화면은 정상 동작한다.
    # 발급: https://console.anthropic.com/settings/keys
    #
    # enabled 는 리터럴이 아니라 환경변수로 받는다 — 켜 둔 채 잊으면 기동·테스트만으로도
    # 과금된다. 실측할 때만 그 실행에 한해 켜는 편이 안전하다.
    #
    # 나머지 값(model · effort · max-tokens · request-timeout · total-budget)은 여기 적지
    # 않는다. application.yml 이 이미 ${ANTHROPIC_*:기본값} 으로 받고 있고 dev 는 그것을
    # 상속하므로, 환경변수만으로 조절된다. 여기 리터럴로 다시 적으면 그 값이 환경변수를
    # 이겨서 "환경변수를 바꿨는데 안 먹는다" 가 된다(이슈 #123 이 운영에서 겪은 것과 같은 함정).
    #
    #   ANTHROPIC_ENABLED=true ANTHROPIC_MODEL=claude-sonnet-5 \
    #   ANTHROPIC_REQUEST_TIMEOUT=60s ANTHROPIC_TOTAL_BUDGET=60s \
    #   ./gradlew bootRun
    #
    # 지연을 잴 때 타임아웃을 크게 잡는 이유 — 기본 12s 로 두면 느린 모델이 폴백해
    # 버려서 재려던 값이 12,000ms 로만 찍힌다. 끊기지 않게 두고 재야 실측이 된다.
    # 측정 결과는 GET /api/v1/admin/ai/calls 의 latency_ms · output_tokens 로 본다.
    anthropic:
      enabled: ${ANTHROPIC_ENABLED:false}
      api-key: ""

spring:
  datasource:
    # 예) docker run -e POSTGRES_USER=divurve -e POSTGRES_PASSWORD=divurve \
    #         -e POSTGRES_DB=divurve -p 5432:5432 postgres
    url: jdbc:postgresql://localhost:5432/divurve
    username: divurve
    password: divurve

  # 로컬에서는 실행되는 SQL 을 확인하기 편하도록 출력
  jpa:
    show-sql: true
